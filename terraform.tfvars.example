# ==================================================================================================
# File:        terraform.tfvars.example
# Module:      terraform-org-level-policy-gcp (repo)
# Description: Example input values for terraform.tfvars.
#
# ACTION REQUIRED: Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
#
# ==================================================================================================
#
# Change History
# --------------------------------------------------------------------------------------------------
# Date        Author                     Version  Description
# ----------  -------------------------  -------  --------------------------------------------------
# 2026-10-08  Steve Hager                1.0.0    Initial creation.
# 2026-10-09  Steve Hager                1.1.0    Added host_tag_users example; SA renamed to
#                                                   tf-org-policy-admin to match the bootstrap repo.
# YYYY-MM-DD  <name>                     x.y.z    <what changed and why>
# --------------------------------------------------------------------------------------------------

org_id          = "123456789012"
billing_project = "shv-bootstrap-xxxx"

# Dedicated SA created in the bootstrap repo (recommended)
terraform_service_account = "tf-org-policy-admin@shv-bootstrap-xxxx.iam.gserviceaccount.com"

# gcloud organizations describe ORG_ID --format='value(owner.directoryCustomerId)'
allowed_customer_ids = ["C0xxxxxxx"]

allowed_locations = ["in:us-locations"]

deny_vm_external_ips = true

# Defaults to all seven; trim to roll out gradually.
# enforced_boolean_constraints = [
#   "compute.skipDefaultNetworkCreation",
#   "compute.requireOsLogin",
#   "iam.disableServiceAccountKeyCreation",
#   "iam.automaticIamGrantsForDefaultServiceAccounts",
#   "storage.uniformBucketLevelAccess",
#   "storage.publicAccessPrevention",
#   "sql.restrictPublicIp",
# ]

# No VMs in Shared VPC host projects (tag-based). The network repo's SA binds the tag.
# host_project_no_vms = true
host_tag_users = ["serviceAccount:terraform-super-admin@shv-bootstrap-xxxx.iam.gserviceaccount.com"]
